{
  "openapi": "3.1.0",
  "info": {
    "title": "maintenance",
    "version": "0.1.0",
    "description": "The routes maintenance serves. Every path is relative to the mount the host assigns."
  },
  "paths": {
    "/overview": {
      "get": {
        "operationId": "read-overview",
        "summary": "Every printer with its hours and its maintenance tasks",
        "responses": {
          "200": {
            "description": "The fleet and its tasks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "alert_percent": {
                      "type": "integer"
                    },
                    "devices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Device"
                      }
                    }
                  },
                  "required": [
                    "alert_percent",
                    "devices"
                  ]
                }
              }
            }
          }
        },
        "description": "Every printer the caller may observe, with its print hours, its print count and its maintenance tasks."
      }
    },
    "/tasks": {
      "post": {
        "operationId": "save-task",
        "summary": "Create a task on a printer, or change one",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Task"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The task as it was written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        },
        "description": "Create a task on a printer, or change one by its id. A task is a check with an interval in print hours or in days."
      },
      "delete": {
        "operationId": "delete-task",
        "summary": "Remove a task",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The id that was removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              }
            }
          }
        },
        "description": "Remove one task by its id."
      }
    },
    "/tasks/done": {
      "post": {
        "operationId": "mark-done",
        "summary": "Mark a task as done at the printer's current hours",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The task as it now stands.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        },
        "description": "Mark a task done: its counter starts again at the printer's current print hours."
      }
    },
    "/devices/hours": {
      "post": {
        "operationId": "save-printer-hours",
        "summary": "Record the print hours the machine's own display shows",
        "description": "The server only sees the prints it recorded. This stores the count the operator read off the printer, so the page can tell the two apart.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "hours": {
                    "type": "number"
                  }
                },
                "required": [
                  "device_id",
                  "hours"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The value that was stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_id": {
                      "type": "string"
                    },
                    "hours": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "device_id",
                    "hours"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/template": {
      "get": {
        "operationId": "read-template",
        "summary": "The schedule every printer starts with",
        "description": "One line per maintenance task, with the interval an operator sets once for the fleet.",
        "responses": {
          "200": {
            "description": "The schedule.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "alert_percent": {
                      "type": "integer"
                    },
                    "tasks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TemplateTask"
                      }
                    }
                  },
                  "required": [
                    "alert_percent",
                    "tasks"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "save-template",
        "summary": "Change one line of the schedule",
        "description": "Carries the new interval to every built-in task of that name, keeping each printer's own counter.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplateTask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The line as it was written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateTask"
                }
              }
            }
          }
        }
      }
    },
    "/devices/tools/reset": {
      "post": {
        "operationId": "reset-tool",
        "summary": "Start one tool's counter again at zero",
        "description": "A nozzle was replaced; the printer's own counter does not move, so the tool's hours are anchored where they stand now.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "tool": {
                    "type": "integer"
                  }
                },
                "required": [
                  "device_id",
                  "tool"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool that was reset.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_id": {
                      "type": "string"
                    },
                    "tool": {
                      "type": "integer"
                    },
                    "hours": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "device_id",
                    "tool",
                    "hours"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/sets": {
      "get": {
        "operationId": "list-sets",
        "summary": "The maintenance schedules",
        "responses": {
          "200": {
            "description": "Every schedule with its lines."
          }
        },
        "description": "Every schedule this module knows, with the lines each one runs."
      },
      "post": {
        "operationId": "create-set",
        "summary": "Write a schedule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "copy_of": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The schedule as it now stands."
          }
        },
        "description": "Write a new schedule, either empty or as a copy of another one."
      }
    },
    "/sets/{id}": {
      "put": {
        "operationId": "update-set",
        "summary": "Rename or switch a schedule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Every schedule with its lines."
          }
        },
        "description": "Rename a schedule, point it at another model, or switch it off so no printer may follow it."
      },
      "delete": {
        "operationId": "delete-set",
        "summary": "Delete a schedule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          }
        },
        "description": "Remove a schedule and its lines. A schedule that ships with this module, or that a printer follows, is refused."
      }
    },
    "/sets/{id}/tasks": {
      "post": {
        "operationId": "add-set-task",
        "summary": "Add a line to a schedule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "interval_hours": {
                    "type": "number"
                  },
                  "interval_days": {
                    "type": "integer"
                  },
                  "material": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "kind"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The line as it now stands."
          }
        },
        "description": "Append a line to a schedule. A schedule that ships with this module is refused; copy it and change the copy."
      }
    },
    "/sets/{id}/tasks/{task}": {
      "put": {
        "operationId": "update-set-task",
        "summary": "Change a line of a schedule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "task",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "interval_hours": {
                    "type": "number"
                  },
                  "interval_days": {
                    "type": "integer"
                  },
                  "material": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "kind"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The line as it now stands."
          }
        },
        "description": "Change one line of a schedule: its name, its interval or the material it covers."
      },
      "delete": {
        "operationId": "delete-set-task",
        "summary": "Remove a line from a schedule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "task",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          }
        },
        "description": "Remove one line from a schedule."
      }
    },
    "/devices/set": {
      "put": {
        "operationId": "assign-set",
        "summary": "Point a printer at a schedule",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "set_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "device_id",
                  "set_id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The printer and the schedule it now follows."
          }
        },
        "description": "Point a printer at a schedule. Its builtin tasks follow that schedule from the next page load on."
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hours",
              "days"
            ]
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "last_done_hours": {
            "type": "number"
          },
          "last_done_at": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean"
          }
        },
        "required": [
          "device_id",
          "name",
          "kind"
        ]
      },
      "TaskView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "last_done_hours": {
            "type": "number"
          },
          "last_done_at": {
            "type": "string"
          },
          "elapsed": {
            "type": "number"
          },
          "remaining": {
            "type": "number"
          },
          "percent": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "device_id",
          "name",
          "kind",
          "elapsed",
          "remaining",
          "percent",
          "status"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "prints": {
            "type": "integer"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskView"
            }
          },
          "printer_hours": {
            "type": "number"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolHours"
            }
          }
        },
        "required": [
          "id",
          "hours",
          "prints",
          "tasks"
        ]
      },
      "TemplateTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hours",
              "days"
            ]
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "material": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      },
      "ToolHours": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "integer"
          },
          "hours": {
            "type": "number"
          },
          "reset_hours": {
            "type": "number"
          }
        },
        "required": [
          "tool",
          "hours"
        ]
      },
      "SetTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "material": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind"
        ]
      },
      "Set": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SetTask"
            }
          }
        },
        "required": [
          "id",
          "name",
          "model",
          "tasks"
        ]
      }
    }
  }
}
