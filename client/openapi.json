{
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hours",
              "days"
            ]
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "last_done_hours": {
            "type": "number"
          },
          "last_done_at": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean"
          }
        },
        "required": [
          "device_id",
          "name",
          "kind"
        ]
      },
      "TaskView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "device_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "last_done_hours": {
            "type": "number"
          },
          "last_done_at": {
            "type": "string"
          },
          "elapsed": {
            "type": "number"
          },
          "remaining": {
            "type": "number"
          },
          "percent": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "material": {
            "type": "string"
          },
          "builtin": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "device_id",
          "name",
          "kind",
          "elapsed",
          "remaining",
          "percent",
          "status"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "prints": {
            "type": "integer"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskView"
            }
          },
          "printer_hours": {
            "type": "number"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolHours"
            }
          }
        },
        "required": [
          "id",
          "hours",
          "prints",
          "tasks"
        ]
      },
      "TemplateTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "hours",
              "days"
            ]
          },
          "interval_hours": {
            "type": "number"
          },
          "interval_days": {
            "type": "integer"
          },
          "material": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      },
      "ToolHours": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "integer"
          },
          "hours": {
            "type": "number"
          }
        },
        "required": [
          "tool",
          "hours"
        ]
      }
    }
  },
  "info": {
    "title": "maintenance",
    "version": "0.1.0",
    "description": "The routes maintenance serves. Every path is relative to the mount the host assigns."
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/modules/com.github.aux.singlergold2.maintenance/devices/hours": {
      "post": {
        "operationId": "save-printer-hours",
        "summary": "Record the print hours the machine's own display shows",
        "description": "The server only sees the prints it recorded. This stores the count the operator read off the printer, so the page can tell the two apart.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "device_id": {
                    "type": "string"
                  },
                  "hours": {
                    "type": "number"
                  }
                },
                "required": [
                  "device_id",
                  "hours"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The value that was stored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "device_id": {
                      "type": "string"
                    },
                    "hours": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "device_id",
                    "hours"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/modules/com.github.aux.singlergold2.maintenance/overview": {
      "get": {
        "operationId": "read-overview",
        "summary": "Every printer with its hours and its maintenance tasks",
        "responses": {
          "200": {
            "description": "The fleet and its tasks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "alert_percent": {
                      "type": "integer"
                    },
                    "devices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Device"
                      }
                    }
                  },
                  "required": [
                    "alert_percent",
                    "devices"
                  ]
                }
              }
            }
          }
        },
        "description": "Every printer the caller may observe, with its print hours, its print count and its maintenance tasks."
      }
    },
    "/api/v1/modules/com.github.aux.singlergold2.maintenance/tasks": {
      "post": {
        "operationId": "save-task",
        "summary": "Create a task on a printer, or change one",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Task"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The task as it was written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        },
        "description": "Create a task on a printer, or change one by its id. A task is a check with an interval in print hours or in days."
      },
      "delete": {
        "operationId": "delete-task",
        "summary": "Remove a task",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The id that was removed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "deleted"
                  ]
                }
              }
            }
          }
        },
        "description": "Remove one task by its id."
      }
    },
    "/api/v1/modules/com.github.aux.singlergold2.maintenance/tasks/done": {
      "post": {
        "operationId": "mark-done",
        "summary": "Mark a task as done at the printer's current hours",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The task as it now stands.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          }
        },
        "description": "Mark a task done: its counter starts again at the printer's current print hours."
      }
    },
    "/api/v1/modules/com.github.aux.singlergold2.maintenance/template": {
      "get": {
        "operationId": "read-template",
        "summary": "The schedule every printer starts with",
        "description": "One line per maintenance task, with the interval an operator sets once for the fleet.",
        "responses": {
          "200": {
            "description": "The schedule.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "alert_percent": {
                      "type": "integer"
                    },
                    "tasks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TemplateTask"
                      }
                    }
                  },
                  "required": [
                    "alert_percent",
                    "tasks"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "save-template",
        "summary": "Change one line of the schedule",
        "description": "Carries the new interval to every built-in task of that name, keeping each printer's own counter.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TemplateTask"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The line as it was written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemplateTask"
                }
              }
            }
          }
        }
      }
    }
  }
}
